{
  "rules": {
    "storyboards": {
      "$scriptId": {
        "$sceneId": {
          ".read": "auth != null && (data.child('userId').val() === auth.uid || data.child('collaborators').child(auth.uid).exists())",
          ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && (data.child('userId').val() === auth.uid || data.child('collaborators').child(auth.uid).val() === 'Editor' || data.child('collaborators').child(auth.uid).val() === 'Owner')))"
        }
      }
    }
  }
}
