rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Storyboard collection security rules
    match /storyboards/{storyboardId} {
      // Allow read if user is authenticated or document belongs to user
      allow read: if request.auth != null;
      // Allow write if user is authenticated and matches document owner
      allow write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
  }
}

