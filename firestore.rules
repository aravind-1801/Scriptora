rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Private per-user namespace (storyboards, preferences, personal workspace sync)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared script-level documents: owner or explicit collaborator only
    match /scripts/{scriptId}/{document=**} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.get('collaboratorIds', [])
      );
      allow write: if request.auth != null && (
        (resource == null && request.resource.data.ownerId == request.auth.uid) ||
        (resource != null && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.get('editorIds', [])
        ))
      );
    }

    match /storyboards/{storyboardId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.ownerId == request.auth.uid) ||
        (resource != null && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.get('collaboratorIds', [])
        ))
      );
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
