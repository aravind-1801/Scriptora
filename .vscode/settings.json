{
  "files.associations": {
    "**/.github/workflows/*.yml": "yaml",
    "**/.github/workflows/*.yaml": "yaml",
    "**/.github/workflows/*": "yaml",
    "deploy.yml": "yaml"
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": [
      "**/.github/workflows/*.yml",
      "**/.github/workflows/*.yaml",
      "deploy.yml"
    ]
  },
  "yaml.validate": true,
  "github-actions.workflows.pinnedVersionWarnings": false
}
